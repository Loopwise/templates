# ---------------------------------------------------------------------------
# Loopwise Connect — OAuth client credentials
# ---------------------------------------------------------------------------
# Issued when you create an OAuth application in your Loopwise school's
# admin UI: https://<your-school>/oauth/applications
#
# When configuring the OAuth client's "Redirect URI", paste the URL the
# server prints at boot — it includes the `/api/auth/oauth2/callback/loopwise`
# path that better-auth's generic-oauth plugin uses. NOTE the `oauth2/`
# segment (different from many OAuth tutorial defaults).
LOOPWISE_CLIENT_ID=
LOOPWISE_CLIENT_SECRET=

# The base URL of your Loopwise school. Each school runs its own OAuth
# authorization server at this hostname — e.g. https://demo.teachify.tw
# or your school's custom domain.
LOOPWISE_BASE_URL=https://demo.teachify.tw

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# The public URL where THIS Next.js app runs. Same value better-auth uses
# to build callback URLs. Set to your tunneled / production URL in prod.
BETTER_AUTH_URL=http://localhost:3000

# A random secret for signing session cookies. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Database (SQLite via Prisma)
# ---------------------------------------------------------------------------
# Stores better-auth's user + session + account tables. Swap for Postgres
# or MySQL by updating prisma/schema.prisma's datasource.
DATABASE_URL=file:./dev.db
