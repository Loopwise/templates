// Prisma schema for the better-auth session store. The four required
// tables (user, session, account, verification) follow better-auth's
// adapter spec — see https://www.better-auth.com/docs/adapters/prisma
//
// `additionalFields` on the `user` model demonstrate the new
// `mapProfileToUser` pass-through from @loopwise/admin-sdk@0.1.0-beta.3+:
// the OAuth `sub` is written to `teachifyUserId` at sign-up.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Loopwise additionalField — populated by mapProfileToUser at sign-up.
  // Matches the OAuth `sub` claim, so you can join your domain tables
  // (orders, enrollments, …) by Loopwise user id without re-fetching.
  teachifyUserId String? @unique

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  // OAuth tokens — better-auth manages refresh transparently.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
