// Prisma schema for the better-auth session store. The four required
// tables (user, session, account, verification) follow better-auth's
// adapter spec — see https://www.better-auth.com/docs/adapters/prisma
//
// `additionalFields` on the `user` model demonstrate the
// `mapProfileToUser` pass-through from @loopwise/admin-sdk:
// - `teachifyUserId` ← OAuth `sub`
// - `schoolId`       ← OAuth `org_id` extension claim
// - `role`           ← derived from OAuth `roles[0]` via ROLE_MAP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  // Nullable per better-auth's adapter spec — some OAuth providers
  // return a profile without `name`, and we shouldn't fail sign-up.
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Loopwise additionalFields — populated by mapProfileToUser at sign-up.
  // - teachifyUserId: matches the OAuth `sub` claim
  // - schoolId:       OAuth `org_id` extension claim (which Loopwise school)
  // - role:           derived from OAuth `roles[0]` via the ROLE_MAP in
  //                   `src/lib/auth.ts` — your app's domain role, not the
  //                   raw Loopwise role name
  teachifyUserId String? @unique
  schoolId       String?
  role           String?

  sessions Session[]
  accounts Account[]

  // Most tenant queries filter by schoolId; `role` is coarse enough to
  // filter in-app on the returned set, so a single-column index is
  // enough for the template. Add a composite (schoolId, role) index
  // later if you have a hot query that combines them.
  @@index([schoolId])
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // better-auth queries sessions by userId on every request; index it
  // so this stays O(log n) once you have real volume.
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  // OAuth tokens — better-auth manages refresh transparently.
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  // For "list this user's linked OAuth accounts" lookups during sign-in
  // + token refresh paths.
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Email verification + password reset flows query by identifier.
  @@index([identifier])
}
